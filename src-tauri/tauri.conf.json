{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tweax",
  "version": "0.2.0-beta.1",
  "identifier": "com.tweax.browser",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Tweax, navigateur",
    "windows": {
      "nsis": {
        "installerIcon": "installer/installer.ico",
        "sidebarImage": "installer/sidebar.bmp",
        "headerImage": "installer/header.bmp",
        "displayLanguageSelector": false,
        "languages": [
          "French",
          "English"
        ]
      },
      "wix": {
        "bannerPath": "installer/wix-banner.bmp",
        "dialogImagePath": "installer/wix-dialog.bmp",
        "language": "fr-FR"
      }
    }
  }
}